if(NOT DEFINED ASTIA_CMAKE_COMMAND OR NOT DEFINED ASTIA_BUILD_DIR OR
   NOT DEFINED ASTIA_C_COMPILER OR NOT DEFINED ASTIA_LIBC_SOURCE_DIR OR
   NOT DEFINED ASTIA_FEATURE_SOURCE OR NOT DEFINED ASTIA_FEATURE_BINARY_DIR)
  message(FATAL_ERROR "feature macro test arguments are incomplete")
endif()

set(ASTIA_STAGE "${ASTIA_FEATURE_BINARY_DIR}/stage")
file(REMOVE_RECURSE "${ASTIA_FEATURE_BINARY_DIR}")
file(MAKE_DIRECTORY "${ASTIA_STAGE}")
execute_process(
  COMMAND "${ASTIA_CMAKE_COMMAND}" --install "${ASTIA_BUILD_DIR}"
          --prefix "${ASTIA_STAGE}"
  RESULT_VARIABLE ASTIA_INSTALL_RESULT
  OUTPUT_VARIABLE ASTIA_INSTALL_OUTPUT
  ERROR_VARIABLE ASTIA_INSTALL_ERROR)
if(NOT ASTIA_INSTALL_RESULT EQUAL 0)
  message(FATAL_ERROR "staged libc install failed:\n${ASTIA_INSTALL_OUTPUT}${ASTIA_INSTALL_ERROR}")
endif()

foreach(ASTIA_FEATURE_HEADER features.h astia/features.h gnu/stubs.h)
  if(EXISTS "${ASTIA_STAGE}/include/${ASTIA_FEATURE_HEADER}")
    message(FATAL_ERROR "staged libc install leaked feature-test header ${ASTIA_FEATURE_HEADER}")
  endif()
endforeach()

set(ASTIA_FEATURE_HEADERS)
file(GLOB_RECURSE ASTIA_FEATURE_HEADERS RELATIVE
  "${ASTIA_STAGE}/include" "${ASTIA_STAGE}/include/*.h")

set(ASTIA_FEATURE_MODES default posix xopen gnu default_source
    posix_xopen all_requests)
set(ASTIA_FEATURE_MODE_default "")
set(ASTIA_FEATURE_MODE_posix
    "-D_POSIX_C_SOURCE=200809L;-DASTIA_EXPECT_POSIX_C_SOURCE=200809L")
set(ASTIA_FEATURE_MODE_xopen
    "-D_XOPEN_SOURCE=700;-DASTIA_EXPECT_XOPEN_SOURCE=700")
set(ASTIA_FEATURE_MODE_gnu
    "-D_GNU_SOURCE;-DASTIA_EXPECT_GNU_SOURCE=1")
set(ASTIA_FEATURE_MODE_default_source
    "-D_DEFAULT_SOURCE;-DASTIA_EXPECT_DEFAULT_SOURCE=1")
set(ASTIA_FEATURE_MODE_posix_xopen
    "-D_POSIX_C_SOURCE=200809L;-DASTIA_EXPECT_POSIX_C_SOURCE=200809L"
    "-D_XOPEN_SOURCE=700;-DASTIA_EXPECT_XOPEN_SOURCE=700")
set(ASTIA_FEATURE_MODE_all_requests
    "-D_POSIX_C_SOURCE=200809L;-DASTIA_EXPECT_POSIX_C_SOURCE=200809L"
    "-D_XOPEN_SOURCE=700;-DASTIA_EXPECT_XOPEN_SOURCE=700"
    "-D_GNU_SOURCE;-DASTIA_EXPECT_GNU_SOURCE=1"
    "-D_DEFAULT_SOURCE;-DASTIA_EXPECT_DEFAULT_SOURCE=1")

foreach(ASTIA_MODE IN LISTS ASTIA_FEATURE_MODES)
  set(ASTIA_MODE_FLAGS "${ASTIA_FEATURE_MODE_${ASTIA_MODE}}")

  execute_process(
    COMMAND "${ASTIA_C_COMPILER}" -std=c11 -Wall -Wextra -Werror -pedantic
            ${ASTIA_MODE_FLAGS}
            -I${ASTIA_STAGE}/include -fsyntax-only "${ASTIA_FEATURE_SOURCE}"
    RESULT_VARIABLE ASTIA_PROBE_RESULT
    OUTPUT_VARIABLE ASTIA_PROBE_OUTPUT
    ERROR_VARIABLE ASTIA_PROBE_ERROR)
  if(NOT ASTIA_PROBE_RESULT EQUAL 0)
    message(FATAL_ERROR "feature macro probe failed in mode ${ASTIA_MODE}:\n${ASTIA_PROBE_OUTPUT}${ASTIA_PROBE_ERROR}")
  endif()

  foreach(ASTIA_HEADER IN LISTS ASTIA_FEATURE_HEADERS)
    set(ASTIA_PROBE "${ASTIA_FEATURE_BINARY_DIR}/probe-${ASTIA_MODE}.c")
    file(WRITE "${ASTIA_PROBE}" "#include <${ASTIA_HEADER}>\nint astia_feature_header_probe;\n")
    execute_process(
      COMMAND "${ASTIA_C_COMPILER}" -std=c11 -Wall -Wextra -Werror -pedantic
              ${ASTIA_MODE_FLAGS}
              -I${ASTIA_STAGE}/include -fsyntax-only "${ASTIA_PROBE}"
      RESULT_VARIABLE ASTIA_HEADER_RESULT
      OUTPUT_VARIABLE ASTIA_HEADER_OUTPUT
      ERROR_VARIABLE ASTIA_HEADER_ERROR)
    if(NOT ASTIA_HEADER_RESULT EQUAL 0)
      message(FATAL_ERROR "staged header ${ASTIA_HEADER} failed in mode ${ASTIA_MODE}:\n${ASTIA_HEADER_OUTPUT}${ASTIA_HEADER_ERROR}")
    endif()
  endforeach()
endforeach()
