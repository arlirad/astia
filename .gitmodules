[submodule "user/zsh"]
	path = user/zsh
	url = https://github.com/zsh-users/zsh.git
[submodule "user/nano"]
	path = user/nano
	url = https://github.com/madnight/nano.git
[submodule "user/gnulib"]
	path = user/gnulib
	url = https://github.com/coreutils/gnulib.git
[submodule "user/ncurses"]
	path = user/ncurses
	url = https://github.com/ThomasDickey/ncurses-snapshots.git
[submodule "user/openssh"]
	path = user/openssh
	url = https://github.com/openssh/openssh-portable.git
