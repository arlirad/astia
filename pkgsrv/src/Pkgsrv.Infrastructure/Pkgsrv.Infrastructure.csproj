<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <RootNamespace>Pkgsrv.Infrastructure</RootNamespace>
    <AssemblyName>Pkgsrv.Infrastructure</AssemblyName>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.Hosting.Abstractions" Version="10.0.7" />
    <PackageReference Include="Npgsql.EntityFrameworkCore.PostgreSQL" Version="10.0.1" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Design" Version="10.0.4">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
  </ItemGroup>
  <ItemGroup>
    <InternalsVisibleTo Include="Pkgsrv.Infrastructure.Tests" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\Pkgsrv.Application\Pkgsrv.Application.csproj" />
    <ProjectReference Include="..\Pkgsrv.Domain\Pkgsrv.Domain.csproj" />
  </ItemGroup>
  <ItemGroup>
    <Compile Remove="Security\IrvaClientAdapterFactory.Real.cs" />
  </ItemGroup>
  <ItemGroup Condition="'$(IrvaClientProject)' != ''">
    <ProjectReference Include="$(IrvaClientProject)" />
    <Compile Remove="Security\IrvaClientAdapterFactory.Default.cs" />
    <Compile Include="Security\IrvaClientAdapterFactory.Real.cs" />
  </ItemGroup>
</Project>
