# Copy to /home/deploy/.config/pkgsrv.env on the deployment host.
# Fill values there only; never commit real values.
# File mode: 0600, owned by the deploy user.

Pkgsrv__Database__ConnectionString=
Pkgsrv__Irva__BaseUrl=
Pkgsrv__Irva__AppToken=

# Optional. Leave commented out unless Irva is reached over a Unix socket.
# Pkgsrv__Irva__SocketAddress=/run/irva/irva.sock

# Optional. Only relevant when Pkgsrv__Build__Enabled is turned on.
# Pkgsrv__Sources__AllowedHosts__0=github.com
# Pkgsrv__Sources__EgressProxy=http://127.0.0.1:3128
# Pkgsrv__Artifacts__QuotaBytes=1073741824
# Pkgsrv__Artifacts__QuotaInodes=1000000
